# Copy to .env.local and fill in. Never commit real values.

# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# textbee: dashboard > API keys
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Shared password for the JMB dashboard
DASHBOARD_PASSWORD=

# Shared secret for the alert job and the incoming-SMS webhook
CRON_SECRET=
SMS_WEBHOOK_SECRET=

# Minutes before a collection round that residents are alerted
ALERT_LEAD_MINUTES=60
