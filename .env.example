# Copy to .env.local and fill in. Never commit real values.

# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# textbee (https://textbee.dev): dashboard > API keys, and the device ID from Devices.
# Leave TEXTBEE_DEVICE_ID empty to use the account's default device.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Same value as the signing secret on the textbee webhook (at least 20 characters)
TEXTBEE_WEBHOOK_SECRET=

# Shared password for the JMB dashboard
DASHBOARD_PASSWORD=

# Shared secret for the alert job
CRON_SECRET=

# Minutes before a collection round that residents are alerted
ALERT_LEAD_MINUTES=60
